Arcv-test__startContainerTest()
{
  # This runs the test docker in interactive mode
  #  use 'ubuntu26' image to start from scratch, the setup-test-container.sh must be called then

  # -it
  #--entrypoint "/home/dock-install-app"
  local containerImage=""
  local containerName=""
  local shotplanPath=""
  local repoPath
  YAML__get ".container-image" containerImage
  YAML__get ".container-name" containerName
  YAML__get ".container-mnt-repo-dst" repoPath

  declare -A arcContainerConfig=""
  YAML__readAll "${ARCV_TEST__VARS["MYDIR"]}/arcv-test-container.yml" arcContainerConfig

  Arcv-test__mountTestRepo

  sudo docker stop "${containerName}" &>/dev/null

  # Force setting of TZ, otherwise shellapi getTimezone which attempt to call datetimectrl, 
  # which may fail when --volume /run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro is not specified
  if ${ARCV_TEST__VARS["container-debug"]} ; then
    sudo docker run -it --rm  \
    --user $(id -u):$(id -g) -w /home/ubuntu \
    --privileged --net host \
    -e TZ="Europe/Paris" \
    --mount type=bind,src=$HOME/riffian/Data/Data/admin/linux/arcv,dst=/usr/bin/arcv \
    --mount type=bind,src=$HOME/riffian/Data/Data/admin/linux/arcv-test,dst=/usr/bin/arcv-test \
    --mount type=bind,src=$HOME/riffian/Data/Data/admin/linux/shell-api,dst=/usr/bin/shell-api \
    --mount type=bind,src=$HOME/riffian/Data/Data/admin/linux/shotplan,dst=/usr/bin/shotplan \
    --mount type=bind,src="${repoPath}",dst="${arcContainerConfig[.storage]}" \
    --name "${containerName}" "${containerImage}" "$1"
  else
    sudo docker run -it --rm  \
    --user $(id -u):$(id -g) -w /home/ubuntu \
    --privileged --net host \
    -e TZ="Europe/Paris" \
    --mount type=bind,src="${repoPath}",dst="${arcContainerConfig[.storage]}" \
    --name "${containerName}" "${containerImage}" "$1"
  fi

  Arcv-test__unmountTestRepo

  # Use the following e.g. to be able to run datetimectrl
  #--volume /run/dbus/system_bus_socket:/run/dbus/system_bus_socket:ro
}

Arcv-test__unmountTestRepo() {
    local repoPathSrc
    local repoPathDst
    YAML__get ".container-mnt-repo-src" repoPathSrc
    YAML__get ".container-mnt-repo-dst" repoPathDst

    _log "Unmounting '${repoPathDst}'"
    if File__dirExists "${repoPathDst}" ; then
        sumo -u -y "${repoPathDst}"
    fi
}

Arcv-test__mountTestRepo() {
    local repoPathSrc
    local repoPathDst
    YAML__get ".container-mnt-repo-src" repoPathSrc
    YAML__get ".container-mnt-repo-dst" repoPathDst
    if ! File__dirExists "${repoPathDst}" ; then
        _makeDir "${repoPathDst}"
    fi
    _log "Mounting '${repoPathSrc}' on '${repoPathDst}'"
    sumo -y "${repoPathSrc}" "${repoPathDst}"
}

